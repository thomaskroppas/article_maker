# Скопируйте в .env и заполните (рабочие значения — в env_with_keys.txt, НЕ коммитить)
ANTHROPIC_API_KEY=
PIXABAY_API_KEYS=key1,key2
UNSPLASH_API_KEYS=key1,key2
# SERP-провайдер шага 1: serper (основной) | xmlstock (альтернатива)
SERP_PROVIDER=serper
SERPER_API_KEY=
# XMLStock — альтернативный провайдер; оставить пустым, если не используется
XMLSTOCK_API_URL=
DATABASE_URL=postgresql://seo:seo@postgres:5432/seo_pipeline
REDIS_URL=redis://redis:6379/0
SETTINGS_ENCRYPTION_KEY=
WP_ENCRYPTION_KEY=
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# --- Хостовые порты docker-compose (только маппинг наружу; внутри docker-сети
# сервисы всегда на стандартных портах postgres:5432 / redis:6379 / backend:8000).
# Дефолты подобраны неконфликтными; при занятости — поменяйте здесь.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=3010
# Фронт после старта: http://localhost:${FRONTEND_HOST_PORT}, API: http://localhost:${BACKEND_HOST_PORT}
