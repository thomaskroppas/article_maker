# Скопируйте в .env и заполните (рабочие значения — в env_with_keys.txt, НЕ коммитить)
ANTHROPIC_API_KEY=
PIXABAY_API_KEYS=key1,key2
UNSPLASH_API_KEYS=key1,key2
# SERP-провайдер шага 1: serper (основной) | xmlstock (альтернатива)
SERP_PROVIDER=serper
SERPER_API_KEY=
# XMLStock — альтернативный провайдер; оставить пустым, если не используется
XMLSTOCK_API_URL=
DATABASE_URL=postgresql://seo:seo@postgres:5432/seo_pipeline
REDIS_URL=redis://redis:6379/0
SETTINGS_ENCRYPTION_KEY=
WP_ENCRYPTION_KEY=
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=
